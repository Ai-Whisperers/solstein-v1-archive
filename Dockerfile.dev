# Solstein Development Dockerfile
# Fast rebuilds with hot reload support

FROM python:3.11-slim-bookworm

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src
ENV ENVIRONMENT=development

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast package management
RUN pip install uv

# Set working directory
WORKDIR /app

# Copy dependency files
COPY pyproject.toml ./

# Install dependencies (will be cached unless pyproject.toml changes)
RUN uv pip install --system -e ".[dev]" || pip install -e ".[dev]"

# Install additional dev tools
RUN pip install watchfiles ipdb py-spy memray

# Expose ports
EXPOSE 8000

# Default command (overridden in docker-compose)
CMD ["uvicorn", "solstein.api.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"]
