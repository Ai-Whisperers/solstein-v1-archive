# SolStein Configuration Template
# Copy this file to .env and update values for your environment
# All environment variables are documented below with descriptions and example values

################################################################################
# ENVIRONMENT & DEBUG
################################################################################

# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (verbose logging, stack traces)
DEBUG=false

################################################################################
# DATABASE CONFIGURATION
################################################################################

# PostgreSQL connection URL (legacy, kept for SQLAlchemy compatibility)
# Format: postgresql://user:password@host:port/database
DATABASE__URL=postgresql://postgres:postgres@localhost:5432/solstein

# Database connection pool size (1-100)
DATABASE__POOL_SIZE=20

# Enable SQL echo logging (logs all SQL statements)
DATABASE__ECHO=false

# Alternative database URLs for different environments
# DATABASE_URL_DEV=postgresql://user:password@localhost:5432/solstein_dev
# DATABASE_URL_TEST=postgresql://user:password@localhost:5432/solstein_test
# DATABASE_URL_PROD=postgresql://user:password@host:5432/solstein_prod

################################################################################
# SUPABASE CONFIGURATION (Intelligence Engine Backend)
################################################################################

# Supabase project URL
SUPABASE__URL=https://your-project.supabase.co

# Supabase service role key (for server-side operations)
SUPABASE__KEY=sb_secret_your_key_here

# Supabase anonymous key (for client-side operations)
SUPABASE__ANON_KEY=sb_publishable_your_key_here

# Supabase PostgreSQL database URL (alternative to DATABASE__URL)
SUPABASE__DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

################################################################################
# REDIS CONFIGURATION (Caching & Job Queues)
################################################################################

# Redis connection URL
# Format: redis://[password@]host:port/database
REDIS__URL=redis://localhost:6379/0

# Cache TTL in seconds (minimum 60)
REDIS__CACHE_TTL=3600

################################################################################
# TEMPORAL ORCHESTRATION (Workflow Engine)
################################################################################

# Temporal server host and port
TEMPORAL__HOST_URL=localhost:7233

# Temporal namespace for workflows
TEMPORAL__NAMESPACE=default

# Temporal API key (optional, for cloud deployments)
# TEMPORAL__API_KEY=your-temporal-api-key

################################################################################
# API CONFIGURATION
################################################################################

# API server host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
API__HOST=127.0.0.1

# API server port (1-65535)
API__PORT=8000

# Enable API debug mode
API__DEBUG=false

# CORS allowed origins (comma-separated or JSON list)
# For development: http://localhost:3000,http://localhost:8000
# For production: https://yourdomain.com
API__CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Allowed HTTP methods for CORS
API__CORS_METHODS=GET,POST,PUT,DELETE

# Allowed request headers for CORS
API__CORS_HEADERS=Authorization,Content-Type

# API URL prefix
API__API_PREFIX=/api/v1

################################################################################
# SECURITY CONFIGURATION
################################################################################

# Secret key for JWT token signing (MUST be changed in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECURITY__SECRET_KEY=change-me-in-production

# JWT algorithm (HS256, HS512, RS256, etc.)
SECURITY__ALGORITHM=HS256

# JWT access token expiration in minutes
SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=30

################################################################################
# LOGGING CONFIGURATION
################################################################################

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOGGING__LEVEL=INFO

# Log format: json or text
LOGGING__FORMAT=json

# Log file path (optional, logs to console if not set)
# LOGGING__FILE_PATH=data/output/logs/solstein.log

# Log rotation policy (e.g., "500 MB", "1 day")
LOGGING__ROTATION=500 MB

# Log retention policy (e.g., "30 days", "1 year")
LOGGING__RETENTION=30 days

################################################################################
# DATA DIRECTORIES
################################################################################

# Input data directory
DATA__DATA_DIR=data/input

# Cache directory
DATA__CACHE_DIR=data/cache

# Export output directory
DATA__EXPORT_DIR=data/output/exports

################################################################################
# EXTERNAL API KEYS (Optional)
################################################################################

# OpenAI API key for GPT models
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your-key-here

# Perplexity API key (currently unused)
# PERPLEXITY_API_KEY=pplx-your-key-here

################################################################################
# DATA SOURCE API KEYS (Optional)
################################################################################

# Exa API key for web search and data extraction
# Get from: https://exa.ai
# EXA_API_KEY=your-exa-key-here

# Crunchbase API key for company data
# Get from: https://www.crunchbase.com/
# CRUNCHBASE_API_KEY=your-crunchbase-key-here

# NewsAPI key for news data extraction
# Get from: https://newsapi.org
# NEWS_API_KEY=your-newsapi-key-here
# NEWSAPI_KEY=your-newsapi-key-here (alternative name)

# PatentsView API key for patent data
# Get from: https://www.patentsview.org/
# PATENTSVIEW_API_KEY=your-patentsview-key-here

# Companies House API key for UK company data
# Get from: https://beta.companieshouse.gov.uk/
# COMPANIES_HOUSE_API_KEY=your-companies-house-key-here

# GitHub token for GitHub API access
# Get from: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your-token-here

# Google API key for web search and other services
# Get from: https://console.cloud.google.com/
# GOOGLE_API_KEY=your-google-api-key-here

# SEC EDGAR timeout in seconds
# SEC_EDGAR_TIMEOUT=30

# Companies House timeout in seconds
# COMPANIES_HOUSE_TIMEOUT=30

# News API timeout in seconds
# NEWS_API_TIMEOUT=30

# Maximum retries for API calls
# MAX_RETRIES=3

# Enrichment batch size
# ENRICHMENT_BATCH_SIZE=10

# Enable enrichment pipeline
# ENRICHMENT_ENABLED=true

################################################################################
# LLM PROVIDER CONFIGURATION
################################################################################

# LLM provider selection: auto|ollama|openai|groq|fireworks|mistral|deepinfra|gemini|nvidia|cerebras|kimi|none
# auto = automatic provider selection based on available keys
LLM_PROVIDER=auto

# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# OpenAI
OPENAI_MODEL=gpt-4o-mini

# Groq (fast inference)
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Fireworks (cost-effective)
FIREWORKS_API_KEY=fw_your-fireworks-key-here
FIREWORKS_MODEL=accounts/fireworks/models/mixtral-8x22b-instruct

# Mistral
MISTRAL_API_KEY=your-mistral-key-here
MISTRAL_MODEL=mistral-large-2411

# DeepInfra
DEEPINFRA_API_KEY=your-deepinfra-key-here
DEEPINFRA_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Google Gemini
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-flash

# NVIDIA NIM
NVIDIA_NIM_API_KEY=nvapi-your-nvidia-key-here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Cerebras
CEREBRAS_API_KEY=csk-your-cerebras-key-here
CEREBRAS_MODEL=llama-3.3-70b

# Kimi (Chinese LLM)
KIMI_API_KEY=sk-kimi-your-kimi-key-here
KIMI_MODEL=kimi-k2-32k

################################################################################
# CELERY CONFIGURATION (Task Queue)
################################################################################

# Celery broker URL (message queue)
# CELERY_BROKER_URL=redis://localhost:6379/1

# Celery result backend (result storage)
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Refresh schedule for periodic tasks (JSON format)
# REFRESH_SCHEDULE={"companies": "0 0 * * *", "signals": "0 */6 * * *"}

################################################################################
# FEATURE FLAGS & EXPERIMENTAL
################################################################################

# Enable/disable specific features
# FEATURE_GITHUB_ANALYSIS=true
# FEATURE_NEWS_ANALYSIS=true
# FEATURE_PATENT_ANALYSIS=true
# FEATURE_FINANCIAL_ANALYSIS=true

################################################################################
# NOTES
################################################################################

# Required Variables (must be set):
# - DATABASE__URL or SUPABASE__DB_URL (at least one)
# - GITHUB_TOKEN (for GitHub data gathering)
#
# Optional Variables (warnings if missing):
# - COMPANIES_HOUSE_API_KEY (Companies House data gathering disabled if missing)
# - GOOGLE_API_KEY (Web search data gathering disabled if missing)
#
# For Production:
# - Change SECURITY__SECRET_KEY to a strong random value
# - Set ENVIRONMENT=production
# - Use HTTPS for all external URLs
# - Rotate API keys regularly
# - Use a secrets management system (AWS Secrets Manager, HashiCorp Vault, etc.)
