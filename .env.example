# SolStein Configuration
# Copy this file to .env and fill in the required values.
# See comments for instructions on obtaining each API key.
#
# Required Variables (must be set before starting):
#   - DATABASE__URL or SUPABASE__DB_URL
#   - SECURITY__SECRET_KEY
#   - GITHUB_TOKEN
#
# Optional Variables (warnings logged at startup if missing):
#   - COMPANIES_HOUSE_API_KEY, GOOGLE_API_KEY, EXA_API_KEY
#   - At least one LLM provider key (or configure OLLAMA_URL for local inference)
#
# For Production:
#   - Set ENVIRONMENT=production
#   - Set SECURITY__SECRET_KEY to a strong random value (32+ chars)
#   - Never commit real secrets to version control
#   - Use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
#   - Rotate API keys regularly

################################################################################
# REQUIRED — must be set before starting the system
################################################################################

# Environment: development | staging | production
ENVIRONMENT=development

# Enable debug mode (verbose logging, stack traces in responses)
DEBUG=false

# Include tracebacks in API error responses — NEVER enable in production
DEBUG_ERRORS=false

# Database connection URL (PostgreSQL)
# Format: postgresql://user:password@host:port/database
# REQUIRED: at minimum DATABASE__URL or SUPABASE__DB_URL must be set
DATABASE__URL=postgresql://user:password@localhost:5432/solstein

# JWT signing secret — REQUIRED, must be changed from default
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECURITY__SECRET_KEY=change-me-to-a-strong-secret-of-32-chars-minimum

# GitHub token — REQUIRED for startup validation and GitHub data gathering
# Get from: https://github.com/settings/tokens (classic, scope: repo read:org)
GITHUB_TOKEN=ghp_your-token-here

################################################################################
# DATABASE CONFIGURATION
################################################################################

# Connection pool size (1-100, default 20)
DATABASE__POOL_SIZE=20

# Enable SQLAlchemy SQL echo logging (verbose, for debugging only)
DATABASE__ECHO=false

################################################################################
# SUPABASE CONFIGURATION (Intelligence Engine Backend)
################################################################################

# Supabase project URL
SUPABASE__URL=https://your-project.supabase.co

# Supabase service role key (for server-side/admin operations)
SUPABASE__KEY=sb_secret_your_key_here

# Supabase anonymous key (for client-side operations)
SUPABASE__ANON_KEY=sb_publishable_your_key_here

# Supabase PostgreSQL database URL (alternative to DATABASE__URL)
SUPABASE__DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

################################################################################
# API CONFIGURATION
################################################################################

# Server bind address (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
API__HOST=127.0.0.1

# Server port (1-65535)
API__PORT=8000

# Enable API debug mode
API__DEBUG=false

# CORS allowed origins (comma-separated)
API__CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Allowed HTTP methods for CORS
API__CORS_METHODS=GET,POST,PUT,DELETE

# Allowed request headers for CORS
API__CORS_HEADERS=Authorization,Content-Type

# API URL prefix
API__API_PREFIX=/api/v1

# Require X-API-Key tenant header for non-public endpoints (disable for local dev only)
# API__REQUIRE_API_KEY=true

################################################################################
# SECURITY CONFIGURATION
################################################################################

# JWT algorithm
SECURITY__ALGORITHM=HS256

# JWT access token expiration in minutes
SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin login email (optional, for admin panel access)
# SECURITY__ADMIN_EMAIL=admin@example.com

# SHA-256 hex hash of admin password (optional)
# Generate with: python -c "import hashlib; print(hashlib.sha256(b'yourpassword').hexdigest())"
# SECURITY__ADMIN_PASSWORD_HASH=

################################################################################
# LOGGING CONFIGURATION
################################################################################

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOGGING__LEVEL=INFO

# Log format: json | text
LOGGING__FORMAT=json

# Log file path (logs to stdout only if not set)
# LOGGING__FILE_PATH=data/output/logs/solstein.log

# Log rotation policy (e.g. "500 MB", "1 day")
LOGGING__ROTATION=500 MB

# Log retention policy (e.g. "30 days", "1 year")
LOGGING__RETENTION=30 days

################################################################################
# DATA DIRECTORIES
################################################################################

# Input data directory (relative paths resolved from project root)
DATA__DATA_DIR=data/input

# Cache directory
DATA__CACHE_DIR=data/cache

# Export output directory
DATA__EXPORT_DIR=data/output/exports

# Market data directory — path to directory containing company .md profile files.
# Required for markdown-based company loading. No hardcoded default.
# Example: data/input/custom_market_runs/2026-03/energy_sector
# DATA__MARKET_DATA_DIR=

################################################################################
# EXTERNAL DATA SOURCE API KEYS (Optional)
################################################################################

# Companies House API key (UK company data)
# Get from: https://beta.companieshouse.gov.uk/
# Warnings logged at startup if missing; CH data gathering disabled
COMPANIES_HOUSE_API_KEY=your-companies-house-key-here

# --- STORY-101: SearXNG self-hosted meta-search (primary web search backend) ---
# SearXNG is included in docker-compose and requires no API key.
# Override URL only if running SearXNG externally.
# SEARXNG_URL=http://searxng:8080
# Comma-separated engine list (optional; SearXNG defaults to all enabled engines)
# SEARXNG_ENGINES=google,bing,duckduckgo,brave
# Search result cache TTL in seconds (default: 3600 = 1 hour)
# SEARCH_CACHE_TTL=3600

# Google API key (FALLBACK web search — only used when SearXNG is unreachable)
# Get from: https://console.cloud.google.com/ -> APIs & Services -> Credentials
# No longer required — SearXNG is the primary search backend
GOOGLE_API_KEY=your-google-api-key-here
# GOOGLE_SEARCH_ENGINE_ID=your-cse-id-here

# Exa API key (web search and data extraction)
# Get from: https://exa.ai -> Dashboard -> API Keys
EXA_API_KEY=your-exa-key-here

# SEC EDGAR user agent string (required by SEC for API access; format: Name email@domain)
# Get from: https://www.sec.gov/developer (register a user agent string)
# SEC_USER_AGENT=YourName your@email.com

# Crunchbase API key (company funding and investor data)
# Get from: https://www.crunchbase.com/
# CRUNCHBASE_API_KEY=your-crunchbase-key-here

# NewsAPI key (news article search)
# Get from: https://newsapi.org
# NEWS_API_KEY=your-newsapi-key-here

# PatentsView API key (patent data from USPTO)
# Get from: https://www.patentsview.org/
# PATENTSVIEW_API_KEY=your-patentsview-key-here

################################################################################
# LLM PROVIDER CONFIGURATION
################################################################################

# LLM provider selection:
#   auto        - use first available key in priority order
#   ollama      - local inference (no API key required)
#   openai | groq | fireworks | mistral | deepinfra | gemini | nvidia |
#   cerebras | kimi | anthropic | siliconflow | alibaba
#   none        - disable all LLM features
LLM_PROVIDER=auto

# --- Ollama (local, no API key required) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# --- OpenAI ---
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Groq (fast inference, generous free tier) ---
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Fireworks (cost-effective) ---
# Get from: https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=fw_your-fireworks-key-here
FIREWORKS_MODEL=accounts/fireworks/models/mixtral-8x22b-instruct

# --- Mistral ---
# Get from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your-mistral-key-here
MISTRAL_MODEL=mistral-large-2411

# --- DeepInfra ---
# Get from: https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=your-deepinfra-key-here
DEEPINFRA_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- Google Gemini ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-flash

# --- NVIDIA NIM ---
# Get from: https://build.nvidia.com/
NVIDIA_NIM_API_KEY=nvapi-your-nvidia-key-here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- Cerebras ---
# Get from: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=csk-your-cerebras-key-here
CEREBRAS_MODEL=llama-3.3-70b

# --- Kimi (Chinese LLM by Moonshot AI) ---
# Get from: https://platform.moonshot.cn/
KIMI_API_KEY=sk-kimi-your-kimi-key-here
KIMI_MODEL=kimi-k2-32k

# --- Anthropic (Claude models) ---
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- SiliconFlow (OpenAI-compatible, budget inference) ---
# Get from: https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=sk-your-siliconflow-key-here
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- Alibaba DashScope (Qwen models) ---
# Get from: https://dashscope.aliyun.com/
ALIBABA_API_KEY=sk-your-alibaba-key-here
ALIBABA_MODEL=qwen-plus

# --- Perplexity (currently unused - reserved for future use) ---
# Get from: https://www.perplexity.ai/settings/api
# PERPLEXITY_API_KEY=pplx-your-key-here

################################################################################
# CELERY CONFIGURATION (Task Queue)
################################################################################

# Celery broker URL (message queue backend)
# CELERY_BROKER_URL=redis://localhost:6379/1

# Celery result backend (task result storage)
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Refresh schedule for periodic tasks (JSON: {"companies": "0 0 * * *"})
# REFRESH_SCHEDULE={"companies": "0 0 * * *", "signals": "0 */6 * * *"}

################################################################################
# FEATURE FLAGS (safe cutover controls - disabled by default)
################################################################################

# Enable the new company classifier pipeline
# FEATURE_NEW_CLASSIFIER=false

# Enable the new readiness gate logic
# FEATURE_NEW_READINESS_GATE=false

# Enable the new unified data loader
# FEATURE_NEW_UNIFIED_LOADER=false

################################################################################
# CONNECTOR RESILIENCE (Optional - sensible defaults provided)
################################################################################

# Maximum retry attempts for connector calls (1-10, default 3)
# CONNECTOR_MAX_ATTEMPTS=3

# Base delay between retries in seconds (default 0.25)
# CONNECTOR_RETRY_BASE_DELAY=0.25

# Maximum retry delay cap in seconds (default 2.0)
# CONNECTOR_RETRY_MAX_DELAY=2.0

# Consecutive failures before circuit breaker opens (default 5)
# CONNECTOR_CIRCUIT_FAILURE_THRESHOLD=5

# Connector circuit breaker cooldown in seconds (default 30.0)
# CONNECTOR_CIRCUIT_COOLDOWN_SECONDS=30.0

################################################################################
# HTTP TIMEOUTS (Optional - sensible defaults provided, values in seconds)
################################################################################

# Default HTTP timeout (default 10)
# HTTP_TIMEOUTS__DEFAULT=10

# GitHub API timeout (default 15)
# HTTP_TIMEOUTS__GITHUB=15

# Companies House API timeout (default 10)
# HTTP_TIMEOUTS__COMPANIES_HOUSE=10

# NewsAPI timeout (default 10)
# HTTP_TIMEOUTS__NEWS_API=10

# SEC EDGAR timeout (default 30, responses can be large)
# HTTP_TIMEOUTS__SEC_EDGAR=30

# Exa search API timeout (default 15)
# HTTP_TIMEOUTS__EXA=15

# Web research pipeline timeout (default 30)
# HTTP_TIMEOUTS__WEB_RESEARCH=30

# Patent search timeout (default 30)
# HTTP_TIMEOUTS__PATENT=30

# Company website scraper timeout (default 10)
# HTTP_TIMEOUTS__WEBSITE_SCRAPER=10

# Funding data API timeout (default 10)
# HTTP_TIMEOUTS__FUNDING=10

# OpenCorporates API timeout (default 15)
# HTTP_TIMEOUTS__OPENCORPORATES=15

# OpenFIGI API timeout (default 15)
# HTTP_TIMEOUTS__OPENFIGI=15

# Web search agent timeout (default 15)
# HTTP_TIMEOUTS__WEB_SEARCH_AGENT=15

# Evidence crawler timeout (default 30)
# HTTP_TIMEOUTS__EVIDENCE_CRAWLER=30

# Celery health check inspect timeout (default 2.0)
# HTTP_TIMEOUTS__HEALTH_CELERY_INSPECT=2.0

################################################################################
# CIRCUIT BREAKER (Optional - sensible defaults provided)
################################################################################

# Consecutive failures before circuit opens (default 5)
# CIRCUIT_BREAKER__FAILURE_THRESHOLD=5

# Seconds in OPEN state before HALF_OPEN probe (default 60.0)
# CIRCUIT_BREAKER__RECOVERY_TIMEOUT=60.0

# Max probe calls in HALF_OPEN state (default 3)
# CIRCUIT_BREAKER__HALF_OPEN_MAX_CALLS=3

# Connector-level circuit breaker cooldown (default 30.0)
# CIRCUIT_BREAKER__COOLDOWN_SECONDS=30.0

################################################################################
# CELERY TIMING (Optional - sensible defaults provided)
################################################################################

# Hard time limit per Celery task in seconds (default 30)
# CELERY_TIMING__TASK_TIME_LIMIT=30

# Soft time limit for graceful shutdown - must be < hard limit (default 25)
# CELERY_TIMING__TASK_SOFT_TIME_LIMIT=25

# Seconds before task results expire from backend (default 3600)
# CELERY_TIMING__RESULT_EXPIRES=3600

# Top-level alias for Celery result TTL — overrides CELERY_TIMING__RESULT_EXPIRES (default: unset)
# CELERY_RESULT_EXPIRES_SECONDS=3600

################################################################################
# LLM ROUTING (Optional - sensible defaults provided)
################################################################################

# Ordered list of LLM providers to try (default: ["deepinfra", "mistral", "nvidia"])
# LLM_PROVIDER_ORDER=["deepinfra", "mistral", "nvidia"]

# Enable per-provider circuit breaker to skip failing providers (default: true)
# LLM_CIRCUIT_BREAKER_ENABLED=true

################################################################################
# OBSERVABILITY (Optional)
################################################################################

# OpenTelemetry collector endpoint for distributed tracing (STORY-050)
# OTLP_ENDPOINT=http://localhost:4318

# Langfuse LLM observability (STORY-073)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

################################################################################
# EMBEDDINGS (Optional - sensible defaults provided)
################################################################################

# OpenAI embedding model name (default: text-embedding-3-small)
# EMBEDDING_MODEL=text-embedding-3-small

# Embedding vector dimensions (default: 1536)
# EMBEDDING_DIMENSIONS=1536

# Batch size for embedding API calls, 1-500 (default: 50)
# EMBEDDING_BATCH_SIZE=50

################################################################################
# LANGGRAPH / HUMAN-IN-THE-LOOP (Optional - sensible defaults provided)
################################################################################

# SQLite path for LangGraph checkpoint persistence (default: data/checkpoints/research_graph.db)
# GRAPH_CHECKPOINT_DB_PATH=data/checkpoints/research_graph.db

# Confidence score below which a run is routed to human review, 0.0-1.0 (default: 0.5)
# HUMAN_REVIEW_CONFIDENCE_THRESHOLD=0.5

# SQLite path for the human review queue (default: data/checkpoints/review_queue.db)
# REVIEW_QUEUE_DB_PATH=data/checkpoints/review_queue.db
