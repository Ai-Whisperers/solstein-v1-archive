{
  "name": "react-native-template",
  "version": "1.0.0",
  "description": "React Native template with modern configuration",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-native": "^0.72.6",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.13",
    "react-native-safe-area-context": "^4.7.3",
    "react-native-screens": "^3.25.0",
    "react-native-gesture-handler": "^2.12.0",
    "react-native-reanimated": "^3.5.1",
    "react-native-vector-icons": "^10.0.2",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/eslint-config": "^3.0.1",
    "@types/react": "^18.2.45",
    "@types/react-native": "^0.72.13",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.76.6",
    "typescript": "^5.2.2",
    "@types/jest": "^29.5.8"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(ts|tsx|js|jsx)$",
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|react-clone-referenced-element|@react-native-community|expo(nent)?|@expo(nent)?/.*|react|@expo-google-fonts/.*|@storybook/.*|react-navigation.*|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  },
  "rnpm": {
    "assets": [
      "./assets/fonts"
    ]
  },
  "files": [
    "index.js",
    "App.tsx",
    "src/**/*"
  ]
}