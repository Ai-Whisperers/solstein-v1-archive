[Unit]
Description=Solstein Autonomous Agent Cycles (24/7 Improvement Loop)
After=network-online.target
Wants=network-online.target
Documentation=file:///home/ai-whisperers/solstein/docs/agent-cycles/

[Service]
Type=simple
WorkingDirectory=/home/ai-whisperers/solstein

# Environment setup
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/home/ai-whisperers/solstein"

# Run orchestrator
ExecStart=/usr/bin/python3 /home/ai-whisperers/solstein/bin/orchestrate_agents.py --continuous

# Auto-restart on failure
Restart=on-failure
RestartSec=30

# Log output
StandardOutput=journal
StandardError=journal
SyslogIdentifier=solstein-agents

# Resource limits
CPUQuota=50%
TasksMax=100

[Install]
WantedBy=default.target
