[Unit]
Description=Solstein Agent Cycle Timer (Every 30 Minutes - Rate Limited)
Requires=solstein-agents.service
Documentation=https://github.com/Ai-Whisperers/solstein/tree/develop/docs

[Timer]
# Run every 30 minutes (48 cycles/day instead of 96)
OnBootSec=1min
OnUnitActiveSec=30min

# If we miss a cycle, run immediately when system comes back
Persistent=true

# Randomize by 1 minute to avoid thundering herd
RandomizedDelaySec=1min

[Install]
WantedBy=timers.target
